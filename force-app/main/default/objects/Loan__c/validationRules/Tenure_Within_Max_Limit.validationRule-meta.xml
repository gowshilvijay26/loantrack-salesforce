<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Tenure_Within_Max_Limit</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
  Tenure_Months__c &lt;= 0,
  Tenure_Months__c &gt; $CustomMetadata.Loan_Setting_mdt__mdt.Default_Settings.Max_Tenure_Months__c
)</errorConditionFormula>
    <errorDisplayField>Tenure_Months__c</errorDisplayField>
    <errorMessage>Tenure must be greater than 0 and within the maximum allowed tenure</errorMessage>
</ValidationRule>
